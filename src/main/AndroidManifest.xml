<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility (API 30+): needed to query BatterySnap's content provider. -->
    <queries>
        <provider android:authorities="com.xhelas.batterysnap.widgetdata" />
        <!-- To find BatterySnap's launch activity. -->
        <package android:name="com.xelacorp.android.batsnaps" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exported: BatterySnap, another app, sends WIDGET_DATA_UPDATE to this receiver. -->
        <receiver
            android:name=".BatterySnapWidgetProvider"
            android:exported="true">
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/battery_snap_widget_info" />

            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.xhelas.batterysnap.WIDGET_DATA_UPDATE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
